{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selecta",
  "version": "0.1.0",
  "identifier": "com.dhruvch1244.selecta",
  "build": {
    "beforeDevCommand": "npm run dev -w @selecta/ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @selecta/ui",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Selecta",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#1b1f22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Music",
    "shortDescription": "AI auto-DJ",
    "longDescription": "Describe a set and Selecta builds and performs it from your own library.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
